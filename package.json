{
  "name": "utilitly-oss",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "typecheck:playground": "tsc -p playground",
    "test": "vitest run",
    "leak-check": "node scripts/leak-check.mjs",
    "lint:packages": "npm run lint:package --workspaces",
    "check": "npm run leak-check && npm run typecheck && npm run build && npm run typecheck:playground && npm test && npm run lint:packages",
    "smoke": "npm run build && node scripts/smoke-install.mjs",
    "playground": "npm run build && vite playground"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@types/node": "^24.19.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "^4.1.12"
  }
}
